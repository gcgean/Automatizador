# Copie para server/.env e preencha. Nunca envie este arquivo para o Git.

PORT=3333

# ===== IA que responde o cliente =====
# claude | deepseek | ollama | openai   (também dá para trocar sem reiniciar: POST /config)
AI_PROVIDER=claude

# Claude (Anthropic). Chave em https://console.anthropic.com
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# low | medium | high  (low é rápido e suficiente para conversa)
CLAUDE_EFFORT=low

# DeepSeek. Chave em https://platform.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# Ollama (modelo local na própria VPS; precisa de um modelo com suporte a ferramentas)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:7b

# Qualquer API compatível com OpenAI (OpenAI, Groq, OpenRouter, etc.)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=

# WhatsApp Cloud API (app da Meta ligado à conta "Command System Suporte")
WHATSAPP_PHONE_NUMBER_ID=1395892046947138
WHATSAPP_GRAPH_VERSION=v23.0
META_APP_ID=1922946735810180
WHATSAPP_WABA_ID=3454868058013423
# Token permanente de um usuário do sistema com permissões whatsapp_business_messaging e whatsapp_business_management
WHATSAPP_ACCESS_TOKEN=
# Chave secreta do app (Configurações do app > Básico)
WHATSAPP_APP_SECRET=
# Texto qualquer que você inventa e repete na configuração do webhook na Meta
WHATSAPP_VERIFY_TOKEN=

# Números dos vendedores que recebem o aviso de lead, só dígitos com DDI, separados por vírgula
VENDEDOR_WHATSAPP=

# Token para consultar GET /leads (Authorization: Bearer <token>)
PAINEL_TOKEN=
